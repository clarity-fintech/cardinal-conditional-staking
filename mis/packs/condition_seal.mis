    constraint pack_bound == true;
  }

  outcome settle_clrty1(intent: Bytes) {
    require intent != @0;
    constraint chain_id == 1202;
  }

  outcome assert_condition_seal_061(payload: Bytes) {
    require payload != @0;
    constraint condition_seal_061_bound == true;
    constraint chain_id == 1202;
  }

